# ==============================================================================
# BreatheWise AI — Environment Variables Configuration Template
# Copy this file to .env and supply actual keys before running services.
# ==============================================================================

# Air Quality Data Providers
WAQI_API_TOKEN=your_waqi_api_token_here
OPENAQ_API_KEY=your_openaq_api_key_here

# Generative AI Providers & Model Identifiers
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL_ID=llama-3.3-70b-versatile

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_ID=gemini-1.5-flash

# Backend Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Cache Expiration (Seconds)
AIR_DATA_CACHE_TTL_SECONDS=1800

# Optional Rate Limiting & Proxy Trust (Security Hardening)
RATE_LIMIT_PLAN_REQUESTS=10
RATE_LIMIT_PLAN_WINDOW_SECONDS=60
RATE_LIMIT_MAX_TRACKED_KEYS=2048
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_CIDRS=

# Optional Supabase Configuration (P1)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
